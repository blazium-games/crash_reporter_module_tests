; Engine configuration file.
config_version=5

[application]

config/name="crash_reporter_module_test"
config/description="End-to-end test project for CrashReporter.write_minidump and sidecar upload."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
crash_reporter/enabled=true
crash_reporter/app_id=""
crash_reporter/app_name=""
crash_reporter/app_version="1.0.0"
crash_reporter/endpoint=""
crash_reporter/upload_mode=2
crash_reporter/reporter_path="bin/crash_reporter.exe"
crash_reporter/spawn_on_crash=true
crash_reporter/require_user_consent=true

[display]

window/size/viewport_width=900
window/size/viewport_height=640

[rendering]

renderer/rendering_method="gl_compatibility"
